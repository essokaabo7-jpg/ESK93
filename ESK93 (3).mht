@charset "utf-8";

:root { --bg: #eef0f3; --card: #fff; --ink: #12161d; --mut: #5d6675; --line: #d9dde4; --acc: #2a47f5; --on: #fff; --ok: #12805c; --warn: #a65b00; }

@media (prefers-color-scheme: dark) {
  :root { --bg: #0e1116; --card: #171b23; --ink: #eef1f6; --mut: #98a2b3; --line: #2a303b; --acc: #7b91ff; --on: #0e1116; --ok: #4cd6a2; --warn: #ffb454; }
}

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font-family: "Bricolage Grotesque", system-ui, sans-serif; padding-bottom: 84px; }

header { position: sticky; top: 0px; background: var(--bg); z-index: 10; padding: 14px 16px 8px; display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }

.logo { font-weight: 800; font-size: 1.9rem; letter-spacing: -0.04em; }

.logo i { font-style: normal; color: var(--acc); }

header span { color: var(--mut); font-size: 0.9rem; text-align: right; }

a { color: var(--acc); }

main { max-width: 760px; margin: 0px auto; padding: 0px 16px; }

input, select, textarea, button { font: inherit; color: inherit; }

.in { width: 100%; background: var(--card); border: 1.5px solid var(--line); border-radius: 10px; padding: 12px; margin-top: 6px; }

.in:focus-visible, button:focus-visible, [role="button"]:focus-visible { outline: 3px solid var(--acc); outline-offset: 2px; }

.row { display: flex; gap: 8px; }

.row > * { flex: 1 1 0%; }

.chips { display: flex; gap: 8px; overflow-x: auto; padding: 10px 0px; }

.chip { flex: 0 0 auto; border: 1.5px solid var(--line); background: var(--card); border-radius: 999px; padding: 7px 14px; cursor: pointer; }

.chip.on { background: var(--ink); color: var(--bg); border-color: var(--ink); }

.grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }

@media (min-width: 620px) {
  .grid { grid-template-columns: repeat(3, 1fr); }
}

.card { background: var(--card); border-radius: 14px; overflow: hidden; cursor: pointer; border: 1px solid var(--line); }

.tile { height: 150px; display: flex; align-items: center; justify-content: center; font-size: 2.6rem; font-weight: 800; background: var(--line); color: var(--mut); }

.info { padding: 10px 12px 12px; }

.info h3 { margin: 0px 0px 4px; font-size: 1rem; font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; }

.pr { font-weight: 800; font-size: 1.1rem; }

.mu { color: var(--mut); font-size: 0.85rem; }

.badge { display: inline-block; background: var(--ok); color: var(--on); border-radius: 6px; padding: 2px 8px; font-size: 0.8rem; font-weight: 600; }

.badge.w { background: var(--warn); }

.badge.g { background: var(--mut); }

.btn { background: var(--acc); color: var(--on); border: 0px; border-radius: 12px; padding: 14px; font-weight: 600; cursor: pointer; width: 100%; }

.btn.alt { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }

.btn:disabled { opacity: 0.45; cursor: default; }

.item { display: flex; gap: 12px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 10px; margin-bottom: 10px; }

.item .tile { width: 64px; height: 64px; font-size: 1.6rem; border-radius: 10px; flex: 0 0 auto; }

.item .info { flex: 1 1 0%; padding: 0px; min-width: 0px; }

.item .acts { display: flex; flex-direction: column; gap: 6px; }

.sm { background: none; border: 1.5px solid var(--line); border-radius: 8px; padding: 6px 10px; cursor: pointer; font-size: 0.85rem; }

h2 { margin: 6px 0px 12px; font-size: 1.4rem; letter-spacing: -0.02em; }

label { display: block; margin-bottom: 12px; font-weight: 600; font-size: 0.9rem; }

.empty { text-align: center; color: var(--mut); padding: 40px 10px; line-height: 1.5; }

.note { background: var(--card); border: 1px dashed var(--line); border-radius: 12px; padding: 12px; color: var(--mut); font-size: 0.9rem; margin: 10px 0px; line-height: 1.45; }

nav { position: fixed; left: 0px; right: 0px; bottom: 0px; background: var(--card); border-top: 1px solid var(--line); display: flex; padding: 8px 6px calc(8px + env(safe-area-inset-bottom,0px)); z-index: 10; }

nav button { flex: 1 1 0%; background: none; border: 0px; padding: 6px 4px; cursor: pointer; color: var(--mut); font-size: 0.72rem; display: flex; flex-direction: column; align-items: center; gap: 3px; }

nav .ic { position: relative; display: block; height: 26px; }

nav svg, .ib svg { width: 25px; height: 25px; stroke: currentcolor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

nav .dot { position: absolute; top: -4px; right: -10px; background: var(--warn); color: var(--on); font-style: normal; font-size: 0.65rem; font-weight: 800; min-width: 17px; height: 17px; border-radius: 9px; display: flex; align-items: center; justify-content: center; padding: 0px 4px; }

nav button.on { color: var(--acc); font-weight: 800; }

#sheet { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.55); z-index: 30; display: flex; align-items: flex-end; justify-content: center; }

.sh { background: var(--bg); width: 100%; max-width: 560px; border-radius: 20px 20px 0px 0px; padding: 16px 16px calc(16px + env(safe-area-inset-bottom,0px)); max-height: 92%; overflow: auto; }

.sh .tile { height: 170px; border-radius: 14px; margin-bottom: 12px; font-size: 4rem; }

#ml { max-height: 46vh; overflow: auto; margin: 10px 0px; display: flex; flex-direction: column; }

.bub { max-width: 82%; padding: 8px 12px; border-radius: 14px; margin: 4px 0px; background: var(--card); border: 1px solid var(--line); overflow-wrap: anywhere; }

.bub.me { margin-left: auto; background: var(--acc); color: var(--on); border: 0px; }

.bub small { display: block; opacity: 0.7; font-size: 0.7rem; }

#toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 999px; z-index: 40; font-weight: 600; max-width: 90%; text-align: center; }

#zoom { position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.92); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 12px; cursor: zoom-out; }

#zoom img { max-width: 100%; max-height: 100%; object-fit: contain; }

.big { width: 100%; max-height: 48vh; object-fit: contain; background: var(--line); border-radius: 14px; display: block; cursor: zoom-in; margin-bottom: 10px; }

.thumbs { display: flex; gap: 8px; margin: 0px 0px 12px; flex-wrap: wrap; }

.thumbs img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 2px solid var(--line); cursor: pointer; }

.thumbs img.on { border-color: var(--acc); }

.av { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: var(--line); display: flex; align-items: center; justify-content: center; font-weight: 800; color: var(--mut); flex: 0 0 auto; }

.av.lg { width: 84px; height: 84px; font-size: 2rem; }

.av.sm { width: 28px; height: 28px; font-size: 0.85rem; }

.hd { display: flex; align-items: center; gap: 8px; }

#who { display: flex; align-items: center; gap: 6px; }

.ib { background: none; border: 0px; padding: 6px; cursor: pointer; color: var(--ink); display: flex; }

.hide { display: none !important; }
